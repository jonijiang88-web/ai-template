# Keep the regular repository exclusions for EAS uploads.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.DS_Store
*.pem
.env*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
data/*.db
supabase/.temp/
.idea
.vercel
*.tsbuildinfo
next-env.d.ts
.devtools

# Generated by the GitHub release workflow immediately before EAS upload.
!mobile/.env.local

# Preserve exclusions from mobile/.gitignore after overriding the root ignore file.
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.kotlin/
mobile/.metro-health-check*
mobile/npm-debug.*
mobile/yarn-debug.*
mobile/yarn-error.*
mobile/.env*.local
!mobile/.env.local
mobile/ios/
mobile/android/
