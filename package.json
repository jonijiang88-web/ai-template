{
  "name": "ai-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "npm run typecheck:shared && npm run typecheck:mobile",
    "typecheck:shared": "cd packages/shared && npx tsc --noEmit",
    "typecheck:mobile": "cd mobile && npx tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:integration": "vitest --run app/_lib/supabase/connectivity.integration.test.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "ai-devtools": "npx @ai-sdk/devtools@latest"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/devtools": "^1.0.7",
    "@ai-sdk/react": "^4.0.40",
    "@ai-template/shared": "*",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.37",
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
